# Copy to .env and fill in. The Anthropic SDK reads these automatically.
#
# This project was developed against a proxy that exposes both the Anthropic
# Messages API and an OpenAI-compatible /v1/embeddings route on the same host.
ANTHROPIC_BASE_URL=https://api.openai-next.com

# Credential. The SDK accepts either ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN;
# this project reads whichever is set (see app/config.py).
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
